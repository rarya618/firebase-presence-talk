{
  "rules": {
    "presence": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.uid === $id",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "lastOnline": {
          ".validate": "newData.isNumber()"
        },
        "connections": {
          "$connectionId": {
            "startedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
